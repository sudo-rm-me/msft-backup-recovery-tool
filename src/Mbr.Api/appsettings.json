{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Mode": "Entra",
    "Entra": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "Audience": "",
      "SpaClientId": "",
      "Scope": ""
    },
    "BootstrapAdmins": []
  },
  "Mbr": {
    "PublicBaseUrl": "https://localhost:5001",
    "Database": { "Provider": "Sqlite" },
    "Encryption": { "KeyWrapper": "Local" },
    "Apps": {
      "Backup": { "ClientId": "", "CertificatePath": "", "CertificatePassword": "", "CertificateThumbprint": "" },
      "Restore": { "ClientId": "", "CertificatePath": "", "CertificatePassword": "", "CertificateThumbprint": "" }
    },
    "Worker": { "Enabled": true, "MaxConcurrency": 4, "MaxRequestsPerTenant": 8 },
    "Notifications": { "Webhooks": [] }
  }
}
